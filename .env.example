##############################################
# Embeddings
##############################################
EMBED_BACKEND=local
ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
# OPENAI_API_KEY=
# EMBED_MODEL=text-embedding-3-small

##############################################
# Vector store
##############################################
VECTOR_DB=qdrant
QDRANT_URL=http://qdrant:6333
INDEX_PATH=.local_index/chroma
DATA_DIR=/app/resources/data

##############################################
# Local LLM via Ollama
##############################################
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

##############################################
# Retrieval and generation
##############################################
TOP_K=6
QDRANT_SCORE_MIN=0.25
CHROMA_DIST_MAX=0.75
LEXICAL_MIN=0.04
MAX_CHUNKS_PER_DOCUMENT=3
CITATION_SNIPPET_CHARS=1200
DEBUG_RAG=0
INTENT_NARROWING=1
RERANK_CE=0
USE_KEYWORD_FALLBACK=1
PASSAGE_SELECTION=0
PASSAGE_SELECTION_K=5
LLM_NUM_PREDICT=220
LLM_NUM_PREDICT_SUMMARY=240
LLM_NUM_CTX=4096

##############################################
# App behavior
##############################################
AUTO_INDEX=1
FORCE_PLAIN=0
API_URL=http://api:8000
CORS_ORIGINS=http://localhost:8501
