##############################################
# Embeddings
##############################################
EMBED_BACKEND=local
ST_MODEL=sentence-transformers/all-MiniLM-L6-v2
# OPENAI_API_KEY=
# EMBED_MODEL=text-embedding-3-small

##############################################
# Vector store
##############################################
VECTOR_DB=qdrant
QDRANT_URL=http://qdrant:6333
INDEX_PATH=.local_index/chroma
DATA_DIR=/app/resources/data

##############################################
# Local LLM via Ollama
##############################################
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

##############################################
# Retrieval and generation
##############################################
TOP_K=6
QDRANT_SCORE_MIN=0.00
CHROMA_DIST_MAX=0.50
LEXICAL_MIN=0.04
DEBUG_RAG=0
RBAC_INTENT=1
RBAC_INTENT_SOFT=1
RETRIEVAL_FILTERS=1
STRICT_CITATIONS=0
RERANK_CE=0
USE_KEYWORD_FALLBACK=1
PASSAGE_SELECTION=0
PASSAGE_SELECTION_K=5
LLM_NUM_PREDICT=220
LLM_NUM_CTX=4096
LLM_NUM_THREAD=4

##############################################
# App behavior
##############################################
AUTO_INDEX=1
FORCE_PLAIN=0
JWT_SECRET=change_me_for_non_demo_use
JWT_EXPIRE_MINUTES=120
API_URL=http://api:8000
